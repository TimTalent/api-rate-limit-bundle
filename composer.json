{
    "name": "indragunawan/api-rate-limit-bundle",
    "type": "symfony-bundle",
    "description": "Rate limits protection for api-platform resources.",
    "keywords": [
        "api-platform",
        "rate-limit"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Indra Gunawan",
            "email": "hello@indra.my.id"
        }
    ],
    "require": {
        "php": "^8.1",
        "api-platform/core": "^2.7 || ^3.0",
        "doctrine/annotations": "^1.13 || ^2.0",
        "symfony/cache": "^5.4 || ^6.4 || ^7.0",
        "symfony/config": "^5.4 || ^6.4 || ^7.0",
        "symfony/dependency-injection": "^5.4 || ^6.4 || ^7.0",
        "symfony/http-foundation": "^5.4 || ^6.4 || ^7.0",
        "symfony/http-kernel": "^5.4 || ^6.4 || ^7.0",
        "symfony/security-bundle": "^5.4 || ^6.4 || ^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "Indragunawan\\ApiRateLimitBundle\\": ""
        },
        "exclude-from-classmap": [
            "Tests/"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
